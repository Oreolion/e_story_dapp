# e-Story Mobile Environment Variables
# Copy to .env and fill in values

API_BASE_URL=https://estories.app
SUPABASE_URL=
SUPABASE_ANON_KEY=
WALLETCONNECT_PROJECT_ID=
GOOGLE_WEB_CLIENT_ID=
EAS_PROJECT_ID=

# Crash reporting (optional but recommended for production)
# Get DSN from https://sentry.io/organizations/YOUR_ORG/projects/estories/
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DEBUG=false  # Set to true to send dev events
